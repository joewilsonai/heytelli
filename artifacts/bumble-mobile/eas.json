{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://heytelli-api-production.up.railway.app"
      }
    },
    "beta": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://heytelli-api-production.up.railway.app"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://heytelli-api-production.up.railway.app"
      }
    }
  },
  "submit": {
    "beta": {
      "ios": {
        "ascAppId": "6773488324"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6773488324"
      }
    }
  }
}
